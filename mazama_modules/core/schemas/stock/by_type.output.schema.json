{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stock.by_type output",
  "type": "object",
  "required": [
    "pie"
  ],
  "properties": {
    "pie": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "total",
            "slices"
          ],
          "properties": {
            "total": {
              "type": "number"
            },
            "title": {
              "type": "string"
            },
            "slices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "value",
                  "slot",
                  "pct"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "slot": {
                    "type": "string"
                  },
                  "pct": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
