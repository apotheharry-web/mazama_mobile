{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stock.order_check input",
  "description": "A center's order as the phone sent it (POST /p/orders): its lines (any JSON; each is checked), the worker's notes and the Strains page's (spelling, name) pairs.",
  "type": "object",
  "required": [
    "lines"
  ],
  "properties": {
    "lines": {
      "type": "array"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
