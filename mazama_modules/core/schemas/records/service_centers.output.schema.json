{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "records.service_centers output",
  "description": "The ServiceCenter entries that count, in the order given, the first entry for an id only: the server's directory.service_centers.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "state_id",
      "name",
      "license"
    ],
    "additionalProperties": false,
    "properties": {
      "state_id": {
        "type": "integer",
        "minimum": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "license": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      }
    }
  }
}
