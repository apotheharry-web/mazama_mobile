{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "names.parse input",
  "description": "Names to read: a packaged product's (kind product, with the manufacturer's license, whose own pattern in formats is tried first) or a harvest batch's or process lot's (kind source); aliases are the Strains page's (spelling, name shown) pairs.",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "product",
              "source"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "formats": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
