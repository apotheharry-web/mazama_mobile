{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selling.pacific_midnight output",
  "description": "Pacific midnight as UTC (the 2007 rule).",
  "type": "object",
  "required": [
    "utc"
  ],
  "properties": {
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T0[78]:00:00\\.000Z$"
    }
  }
}
