{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selling.parse_sale_date output",
  "description": "The date, or why not.",
  "type": "object",
  "required": [
    "date",
    "error"
  ],
  "properties": {
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "error": {
      "enum": [
        null,
        "bad",
        "future"
      ]
    }
  }
}
