{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selling.sale_date_bounds output",
  "description": "The first and last day a sale may be dated.",
  "type": "object",
  "required": [
    "earliest",
    "latest"
  ],
  "properties": {
    "earliest": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "latest": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
