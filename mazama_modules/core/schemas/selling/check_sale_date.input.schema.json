{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selling.check_sale_date input",
  "description": "A sale's date (SALE-1, SALE-18).",
  "type": "object",
  "required": [
    "date",
    "today"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "today": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
