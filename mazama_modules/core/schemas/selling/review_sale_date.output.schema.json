{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selling.review_sale_date output",
  "description": "Its Pacific date, or null.",
  "type": "object",
  "required": [
    "date"
  ],
  "properties": {
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
