{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selling.expiry input",
  "description": "A package's expiry date.",
  "type": "object",
  "required": [
    "expires",
    "today",
    "fresh_months"
  ],
  "properties": {
    "expires": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "today": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fresh_months": {
      "type": "integer"
    }
  }
}
