{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selling.check_sale_date output",
  "description": "null: it may be sold on that date.",
  "type": "object",
  "required": [
    "date",
    "error"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "error": {
      "enum": [
        null,
        "future",
        "too_old"
      ]
    }
  }
}
