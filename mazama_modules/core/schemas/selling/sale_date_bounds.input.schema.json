{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selling.sale_date_bounds input",
  "description": "The Pacific date of today.",
  "type": "object",
  "required": [
    "today"
  ],
  "properties": {
    "today": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
