  {"name": "another_key", "why": "exactly the two keys: an older app ignores a list in a newer shape as a whole", "valid": false, "text": "{\"version\": \"2026-11-01.1\", \"hosts\": [], \"remove\": [\"psilocybin.oregon.gov\"]}"},
