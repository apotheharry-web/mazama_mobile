{
 "about": "The signed sign-in host list (SL-R18; global constraints of specs/state-login/06-phase5b.plan.md, \"Host list format\"). parse(text) must give `valid` for every case, and for a valid one exactly `version` and `hosts` (in the file's order). The rule: the file is UTF-8 JSON, at most max_bytes bytes, an object with exactly the keys \"version\" (a spec_version, YYYY-MM-DD.N) and \"hosts\" (a list of at most max_hosts different texts); each host is lower-case ASCII letters, digits and hyphens in two or more dot-separated labels of 1 to 63 characters, none starting or ending with a hyphen, at most 253 characters in all, and its last label is not a number (all digits, or 0x and hex digits: an IP address literal). No leading or trailing dot, no `*`, no port, no scheme, no path. Anything else makes the whole list invalid. A valid list's hosts are added to the built-in two, never replace them (listing a built-in one adds nothing). The signature is checked first (signing_vectors.json); these cases are about the text alone. Run by mazama_sales/tests/state/test_login_hosts.py and the phone's host list test.",
 "max_bytes": 65536,
 "max_hosts": 10,
 "cases": [
  {"name": "one_host", "valid": true, "text": "{\"version\": \"2026-11-01.1\", \"hosts\": [\"login.example.gov\"]}", "version": "2026-11-01.1", "hosts": ["login.example.gov"]},
  {"name": "no_hosts", "why": "an empty list is valid: it adds nothing", "valid": true, "text": "{\"version\": \"2026-11-01.2\", \"hosts\": []}", "version": "2026-11-01.2", "hosts": []},
  {"name": "pretty_printed_with_newline", "valid": true, "text": "{\n  \"hosts\": [\n    \"a.example.gov\",\n    \"b.example.gov\"\n  ],\n  \"version\": \"2026-11-01.10\"\n}\n", "version": "2026-11-01.10", "hosts": ["a.example.gov", "b.example.gov"]},
  {"name": "ten_hosts", "valid": true, "text": "{\"version\": \"2026-11-01.1\", \"hosts\": [\"h0.example.gov\", \"h1.example.gov\", \"h2.example.gov\", \"h3.example.gov\", \"h4.example.gov\", \"h5.example.gov\", \"h6.example.gov\", \"h7.example.gov\", \"h8.example.gov\", \"h9.example.gov\"]}", "version": "2026-11-01.1", "hosts": ["h0.example.gov", "h1.example.gov", "h2.example.gov", "h3.example.gov", "h4.example.gov", "h5.example.gov", "h6.example.gov", "h7.example.gov", "h8.example.gov", "h9.example.gov"]},
  {"name": "a_built_in_host_listed", "why": "allowed, and adds nothing", "valid": true, "text": "{\"version\": \"2026-11-01.1\", \"hosts\": [\"psilocybin.oregon.gov\", \"login.example.gov\"]}", "version": "2026-11-01.1", "hosts": ["psilocybin.oregon.gov", "login.example.gov"]},
  {"name": "digits_hyphens_and_punycode", "valid": true, "text": "{\"version\": \"2026-11-01.1\", \"hosts\": [\"login-2.example.gov\", \"a1.b2.c3d\", \"xn--bcher-kva.example\"]}", "version": "2026-11-01.1", "hosts": ["login-2.example.gov", "a1.b2.c3d", "xn--bcher-kva.example"]},
  {"name": "label_of_63", "valid": true, "text": "{\"version\": \"2026-11-01.1\", \"hosts\": [\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.gov\"]}", "version": "2026-11-01.1", "hosts": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.gov"]},
  {"name": "host_of_253", "valid": true, "text": "{\"version\": \"2026-11-01.1\", \"hosts\": [\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.gov\"]}", "version": "2026-11-01.1", "hosts": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.gov"]},
  {"name": "not_json", "valid": false, "text": "version: 2026-11-01.1\nhosts: [login.example.gov]\n"},
