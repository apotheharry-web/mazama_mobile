<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of this app's goes into Google cloud backup or a device-to-device transfer. The app's files
     hold the worker's state-system session (session.json: email, access and refresh tokens); a restored copy would be
     a working sign-in on another phone. See SIGN-IN-SECURITY.md, claim 9. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
