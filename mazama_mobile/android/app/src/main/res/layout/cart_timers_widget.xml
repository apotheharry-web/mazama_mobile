<?xml version="1.0" encoding="utf-8"?>
<!-- The cart timers home-screen widget (CartTimersWidget.kt, specs/multi-cart MC-D15). A widget's views can't be
     made at run time, so it has one row per cart a center may have (cart_slots.dart maxCartsPerCenter, 10):
     cart_timer_row0..9, each hidden until CartTimersWidgetProvider fills it. Only running timers are
     listed, in the app's carts order; rows past the widget's height are cut off (the widget can be resized). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cart_timers_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cart_timers_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/cart_timers_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/cart_timers_widget_title"
        android:textColor="@color/cart_timers_subtle"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cart_timers_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="@string/cart_timers_widget_empty"
        android:textColor="@color/cart_timers_subtle"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/cart_timer_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/cart_timer_name0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cart_timers_text"
            android:textSize="14sp" />

        <Chronometer
            android:id="@+id/cart_timer_clock0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/cart_timers_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cart_timer_note0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:textColor="@color/cart_timers_subtle"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
